# sway config, kept identical to i3 where Wayland allows.
#
# Please see sway(5) for a complete reference!

# Keys, workspaces, colours and borders shared with i3
include ~/.config/wm/common.conf

# Arch's defaults: export WAYLAND_DISPLAY etc. to systemd and D-Bus, which
# portals, notifications and the tray applet need
include /etc/sway/config.d/*

# A portal started earlier under i3 keeps i3's environment, so screenshots
# (flameshot) time out. Restart it once sway's environment is exported.
exec sh -c 'systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP && systemctl --user restart xdg-desktop-portal'

# Everything below is sway only (Wayland programs or sway-specific syntax).

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment sway

# Wallpaper (stretch matches feh --bg-scale in i3)
output * bg ~/wallpapers/a_mountain_landscape_with_trees_and_a_building_on_top.png stretch

# Lock and turn the screen off after 10 minutes idle, and lock before suspend
# or on `loginctl lock-session`, like xss-lock with the X screensaver in i3.
exec swayidle -w \
    timeout 600 'swaylock -f' \
    timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    before-sleep 'swaylock -f' \
    lock 'swaylock -f'

# nm-applet needs --indicator to show up in waybar's tray
exec --no-startup-id nm-applet --indicator

# move tiling windows by dragging them with the floating modifier held
tiling_drag enable

# reload the configuration file (sway can't restart in place like i3)
bindsym $mod+Shift+r reload
# exit sway (logs you out of your Wayland session)
bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# Laptop panel is 2560x1600: 1 is too small, 2 too big, 1.5 picked by eye
output eDP-1 scale 1.5

# Workspace outputs. Sway has no "primary" output, so the laptop panel (eDP-1)
# plays that role: 1-9 prefer an external screen, 10 stays on the laptop.
workspace 1 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 2 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 3 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 4 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 5 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 6 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 7 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 8 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 9 output DP-1 DP-2 HDMI-A-1 eDP-1
workspace 10 output eDP-1

# Keyboard: same layout and key repeat as X (setxkbmap -query, xset q)
input type:keyboard {
    xkb_layout us
    xkb_model pc105
    repeat_delay 660
    repeat_rate 25
}

# Bar: waybar, styled like polybar (.config/waybar). The bar block makes sway
# start it on every output and restart it on reload.
bar {
    swaybar_command waybar
}

# Tell waybar's caps lock indicator to refresh (signal 8, see .config/waybar)
bindsym --release Caps_Lock exec pkill -SIGRTMIN+8 waybar
